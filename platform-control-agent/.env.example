# Platform Control Agent Development Environment Example
# Copy this file to .env and adjust as needed

# Service Configuration
PLATFORM_AGENT_PORT=50000
PLATFORM_AGENT_METRICS_PORT=9090
MOCK_API_PORT=8080

# TLS Configuration
TLS_ENABLED=true
TLS_CERT_PATH=/app/certs/server.crt
TLS_KEY_PATH=/app/certs/server.key
TLS_CA_PATH=/app/certs/ca.crt

# Bottlerocket API Configuration
# Development: Use mock API
BOTTLEROCKET_API_URL=http://mock-bottlerocket:8080
# Production: Use Unix socket
# BOTTLEROCKET_API_URL=unix:///run/api.sock

# etcd Configuration
ETCD_ENDPOINTS=http://etcd:2379
ETCD_NAMESPACE=/platform-control

# Logging Configuration
RUST_LOG=debug
RUST_BACKTRACE=1

# Development Mode (disables TLS)
DEV_MODE=true

# Prometheus Configuration
PROMETHEUS_ENDPOINT=http://prometheus:9090

# Grafana Configuration
GRAFANA_ENDPOINT=http://grafana:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Feature Flags
ENABLE_METRICS=true
ENABLE_TRACING=false
ENABLE_MOCK_MODE=true

# FIPS Mode
# Set to 1 to enable FIPS compliance checking
OPENSSL_FIPS=1